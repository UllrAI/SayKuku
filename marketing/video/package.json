{
  "name": "saykuku-launch-film",
  "version": "1.0.0",
  "private": true,
  "description": "SayKuku brand film, built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/compose-audio.mjs",
    "render": "remotion render src/index.tsx SayKuku ../../Dist/marketing/SayKuku-Launch-1080p.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k --concurrency=2",
    "poster": "remotion still src/index.tsx SayKuku ../../Dist/marketing/SayKuku-Poster.png --frame=1150"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.530",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.183.1",
    "typescript": "5.9.3"
  }
}
