{
  "name": "saykuku-product-overview-film",
  "version": "1.0.0",
  "private": true,
  "description": "SayKuku product film (zh and en), built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "audio": "python3 scripts/score.py",
    "render:zh": "remotion render src/index.tsx SayKuku-zh ../../../Dist/marketing/SayKuku-Film-zh-1080p.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=256k",
    "render:en": "remotion render src/index.tsx SayKuku-en ../../../Dist/marketing/SayKuku-Film-en-1080p.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=256k",
    "render": "npm run render:zh && npm run render:en",
    "poster": "remotion still src/index.tsx SayKuku-zh ../../../Dist/marketing/SayKuku-Poster-zh.png --frame=188 && remotion still src/index.tsx SayKuku-en ../../../Dist/marketing/SayKuku-Poster-en.png --frame=188",
    "storyboard": "node scripts/storyboard.mjs zh && node scripts/storyboard.mjs en"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@remotion/cli": "4.0.530",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.530",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.183.1",
    "typescript": "5.9.3"
  }
}
